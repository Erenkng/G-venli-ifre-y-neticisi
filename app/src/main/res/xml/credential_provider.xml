<?xml version="1.0" encoding="utf-8"?>
<!--
    Kasa'nın sisteme bildirdiği kimlik bilgisi yetenekleri.

    Yalnızca passkey (public key credential) bildiriliyor. Parola yeteneğini de
    eklemek teknik olarak mümkün ama doğru değil: parolalar zaten Otomatik
    Doldurma üzerinden çalışıyor ve iki ayrı yoldan aynı parolayı sunmak,
    kullanıcıya aynı hesabı iki kez gösterip hangisinin ne olduğunu belirsiz
    kılardı.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/passkey_provider_subtitle">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
