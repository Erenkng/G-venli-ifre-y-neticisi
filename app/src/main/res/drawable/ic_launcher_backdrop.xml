<?xml version="1.0" encoding="utf-8"?>
<!--
    Uyarlanabilir simgenin arka planı.

    Düz renk yerine çok hafif bir degrade: başlatıcı arka plan katmanını
    ön plandan bağımsız kaydırdığı (paralaks) için düz bir zemin o hareket
    sırasında ölü görünüyor, degrade ise derinlik veriyor. Geçiş bilerek
    zayıf — simge küçültüldüğünde iki uç birbirine karışıp tek renk gibi
    okunmalı, "gradyan efekti" gibi değil.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#00796B" />
                <item android:offset="0.55" android:color="#00695C" />
                <item android:offset="1.0" android:color="#005349" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
