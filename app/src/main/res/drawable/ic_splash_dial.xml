<?xml version="1.0" encoding="utf-8"?>
<!--
    Açılış ekranındaki kasa kadranı.

    Başlatıcı simgesiyle (ic_launcher_foreground) aynı işaret, aynı ölçüler —
    ama canlandırılabilmesi için yapısı farklı: üç kol tek bir grubun ("kadran")
    içinde toplanmış, böylece hepsi tek bir döndürme animasyonuyla birlikte
    dönüyor. Çember dışarıda kalıyor, çünkü dönmemesi gereken parça o: gerçek
    bir kasada kadran döner, kapağa gömülü halka durur.

    ### Neden her parça iki kez çizili

    İşaret açılışta **gradyanlı** duruyor — başlatıcıdaki simgeyle aynı yüz —
    ve animasyonun sonuna doğru uygulamanın içinde kullanılan düz tona
    çözülüyor. Gradyanın açılış ekranında durup uygulamada kaybolması, iki
    farklı işaret görme hissi verirdi; burada geçiş göz önünde oluyor ve
    kullanıcı aynı nesnenin sadeleştiğini görüyor.

    Geçiş çapraz sönme ile yapılıyor ve bu yüzden her parçanın iki kopyası
    var: gradyanlı olan ve düz olan. Vektör çiziminde `<group>` saydamlık
    taşımıyor — yalnızca `<path>` üzerindeki `fillAlpha` ve `strokeAlpha`
    canlandırılabiliyor. Tek bir gruba saydamlık verip beş yerine bir animasyon
    yazmak mümkün olsaydı öyle yapılırdı; sınır biçimin kendisinden geliyor.

    Düz kopyalar `fillAlpha="0"` ile başlıyor: canlandırma çalışmadan önceki
    tek karede iki kopyanın üst üste görünmesini önlüyor.

    ### Renkler neden sabit

    Açılış ekranı henüz uygulama teması kurulmadan, sistem tarafından
    çiziliyor; tema niteliklerine (?attr) burada erişilemiyor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Çember: gradyanlı. trimPathEnd sıfır, çünkü açılışta kendini çiziyor. -->
    <path
        android:name="cember"
        android:trimPathEnd="0"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M26,54 A28,28 0 0,1 82,54 A28,28 0 0,1 26,54 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="26"
                android:endX="82" android:endY="82">
                <item android:offset="0.0" android:color="#EAFFF8" />
                <item android:offset="0.55" android:color="#A6F0DE" />
                <item android:offset="1.0" android:color="#3FBFA4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Çemberin düz kopyası: gradyan çözülürken bunun üzerine geliyor. -->
    <path
        android:name="cemberDuz"
        android:strokeColor="#A6F0DE"
        android:strokeAlpha="0"
        android:trimPathEnd="0"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M26,54 A28,28 0 0,1 82,54 A28,28 0 0,1 26,54 Z" />

    <!-- Dönen parça: üç kol + göbek + mil deliği. Saat 12 yönü boş bırakıldı
         ki çember üstte kesintisiz okunsun; dönerken de boşluğun yer
         değiştirmesi hareketi görünür kılıyor. -->
    <group
        android:name="kadran"
        android:pivotX="54"
        android:pivotY="54">

        <group android:pivotX="54" android:pivotY="54" android:rotation="30">
            <path android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="50.5" android:startY="31.5"
                        android:endX="57.5" android:endY="48">
                        <item android:offset="0.0" android:color="#EAFFF8" />
                        <item android:offset="1.0" android:color="#5FD3B8" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:name="kolDuz1"
                android:fillColor="#A6F0DE"
                android:fillAlpha="0"
                android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z" />
        </group>

        <group android:pivotX="54" android:pivotY="54" android:rotation="150">
            <path android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="50.5" android:startY="31.5"
                        android:endX="57.5" android:endY="48">
                        <item android:offset="0.0" android:color="#EAFFF8" />
                        <item android:offset="1.0" android:color="#5FD3B8" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:name="kolDuz2"
                android:fillColor="#A6F0DE"
                android:fillAlpha="0"
                android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z" />
        </group>

        <group android:pivotX="54" android:pivotY="54" android:rotation="270">
            <path android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="50.5" android:startY="31.5"
                        android:endX="57.5" android:endY="48">
                        <item android:offset="0.0" android:color="#EAFFF8" />
                        <item android:offset="1.0" android:color="#5FD3B8" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:name="kolDuz3"
                android:fillColor="#A6F0DE"
                android:fillAlpha="0"
                android:pathData="M50.5,31.5 a3.5,3.5 0 0,1 7,0 v13 a3.5,3.5 0 0,1 -7,0 Z" />
        </group>

        <!-- Göbek -->
        <path android:pathData="M54,54 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="49" android:centerY="49"
                    android:gradientRadius="20">
                    <item android:offset="0.0" android:color="#FFFFFF" />
                    <item android:offset="0.45" android:color="#B7F4E4" />
                    <item android:offset="1.0" android:color="#40C0A6" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:name="gobekDuz"
            android:fillColor="#A6F0DE"
            android:fillAlpha="0"
            android:pathData="M54,54 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" />

        <!-- Mil deliği: zeminle aynı renk olduğu için delik gibi okunuyor.
             Gradyanı yok — delik bir yüzey değil, yüzeyin yokluğu. -->
        <path
            android:fillColor="#00695C"
            android:pathData="M54,54 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    </group>
</vector>
